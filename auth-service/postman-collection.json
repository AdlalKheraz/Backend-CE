		{
			"name": "auth",
			"item": [
				{
					"name": "register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response && response.token) {",
									"    pm.environment.set(\"token\", response.token);",
									"    console.log(\"Token saved: \" + response.token.substring(0, 20) + '...');",
									"    ",
									"    // Si l'ID de l'utilisateur est disponible, le stocker",
									"    if (response.id) {",
									"        pm.environment.set(\"userId\", response.id);",
									"    }",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\":\"email2\",\n    \"password\": \"password2\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "http://{{gateway_url}}/api/auth/register"
					},
					"response": []
				},
				{
					"name": "login",
