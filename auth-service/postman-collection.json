          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Enregistrement automatique du token JWT pour les requêtes suivantes",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.environment.set(\"jwt_token\", jsonData.token);",
                  "        console.log(\"Token JWT enregistré dans la variable d'environnement 'jwt_token'\");",
                  "    }",
                  "}"
                ],
