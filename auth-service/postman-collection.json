              "raw": "{{base_url}}/api/test/protected",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "test",
                "protected"
              ]
            },
            "description": "Endpoint protégé utilisant l'authentification par cookie JWT"
          },
          "response": []
        },
        {
          "name": "Protected Endpoint (Bearer Auth)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/test/protected",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "test",
                "protected"
              ]
            },
            "description": "Endpoint protégé utilisant l'authentification par Bearer token JWT"
          },
          "response": []
        },
        {
          "name": "Cookie Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Vérifie le statut du cookie\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('cookieStatus');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/test/cookie",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "test",
                "cookie"
              ]
            },
            "description": "Endpoint pour tester la présence des cookies"
          },
          "response": []
        }
      ],
      "description": "Endpoints pour tester l'authentification par cookie et token JWT"
    }
