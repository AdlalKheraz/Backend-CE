{
  "info": {
    "_postman_id": "3f7b0f1c-5e9b-4b4c-9ae7-2a6f76a3fc67",
    "name": "Chrono Auth Service",
    "description": "Collection pour tester les endpoints du service d'authentification avec support des cookies",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Enregistrement automatique du token JWT pour les requêtes suivantes",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.environment.set(\"jwt_token\", jsonData.token);",
                  "        console.log(\"Token JWT enregistré dans la variable d'environnement 'jwt_token'\");",
                  "    }",
                  "    // Vérification de la présence du cookie",
                  "    pm.test(\"Cookie JWT est présent\", function() {",
                  "        pm.expect(pm.cookies.has(\"jwt\")).to.be.true;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Enregistre un nouvel utilisateur, génère un token JWT et définit un cookie"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Enregistrement automatique du token JWT pour les requêtes suivantes",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.environment.set(\"jwt_token\", jsonData.token);",
                  "        console.log(\"Token JWT enregistré dans la variable d'environnement 'jwt_token'\");",
                  "    }",
                  "    // Vérification de la présence du cookie",
                  "    pm.test(\"Cookie JWT est présent\", function() {",
                  "        pm.expect(pm.cookies.has(\"jwt\")).to.be.true;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authentifie un utilisateur existant, génère un token JWT et définit un cookie"
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Message de déconnexion reçu\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"Déconnexion réussie\");",
                  "});",
                  "",
                  "pm.test(\"Cookie JWT est supprimé ou expiré\", function() {",
                  "    const jwtCookie = pm.cookies.get(\"jwt\");",
                  "    pm.expect(!jwtCookie || jwtCookie === \"\").to.be.true;",
                  "});",
                  "",
                  "// Effacer le token JWT de l'environnement",
                  "pm.environment.unset(\"jwt_token\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Déconnecte l'utilisateur en invalidant le cookie JWT"
          },
          "response": []
        }
      ],
      "description": "Endpoints d'authentification pour l'inscription, la connexion et la déconnexion"
    },
    {
