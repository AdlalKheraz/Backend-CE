{
  "info": {
    "name": "Chrono Explorer API",
    "description": "Collection pour tester l'API complète de Chrono Explorer avec authentification JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentification",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "test@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Enregistrement d'un nouvel utilisateur"
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "test@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Connexion et obtention du JWT dans un cookie"
          },
          "response": []
        },
        {
          "name": "Check Auth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/auth/check",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "check"]
            },
            "description": "Vérifier l'état d'authentification actuel"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/auth/logout",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Déconnexion et suppression du cookie JWT"
          },
          "response": []
        }
      ],
      "description": "Endpoints liés à l'authentification et à la gestion des utilisateurs"
    },
    {
      "name": "2. Civilisations",
      "item": [
        {
          "name": "Créer une civilisation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Empire Romain\",\n  \"description\": \"L'Empire romain est le nom donné au régime politique et au territoire ayant succédé à la République romaine.\",\n  \"startDate\": \"-0027-01-16\",\n  \"endDate\": \"0476-09-04\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/event/civilizations",
              "host": ["{{gateway_url}}"],
              "path": ["api", "event", "civilizations"]
            },
            "description": "Créer une nouvelle civilisation (nécessite d'être authentifié)"
          },
          "response": []
        },
        {
          "name": "Liste des civilisations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/event/civilizations",
              "host": ["{{gateway_url}}"],
              "path": ["api", "event", "civilizations"]
            },
            "description": "Récupérer toutes les civilisations"
          },
          "response": []
        }
      ],
      "description": "Endpoints liés à la gestion des civilisations"
    },
    {
      "name": "3. Événements",
      "item": [
        {
          "name": "Créer un événement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fondation de Rome\",\n  \"date\": \"-0753-04-21\",\n  \"description\": \"Selon la légende, Rome est fondée par Romulus et Remus sur les rives du Tibre.\",\n  \"civilizationId\": 1\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/event/events",
              "host": ["{{gateway_url}}"],
              "path": ["api", "event", "events"]
            },
            "description": "Créer un nouvel événement (nécessite d'être authentifié)"
          },
          "response": []
        },
        {
          "name": "Liste des événements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/event/events",
              "host": ["{{gateway_url}}"],
              "path": ["api", "event", "events"]
            },
            "description": "Récupérer tous les événements"
          },
          "response": []
        },
        {
          "name": "Événements par civilisation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/event/civilizations/1/events",
              "host": ["{{gateway_url}}"],
              "path": ["api", "event", "civilizations", "1", "events"]
            },
            "description": "Récupérer tous les événements d'une civilisation spécifique (remplacer 1 par l'ID réel)"
          },
          "response": []
        }
      ],
      "description": "Endpoints liés à la gestion des événements historiques"
    },
    {
      "name": "4. Médias",
      "item": [
        {
          "name": "Ajouter un média",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://upload.wikimedia.org/wikipedia/commons/d/d8/Ara_pacis_roma.JPG\",\n  \"type\": \"IMAGE\",\n  \"eventId\": 1\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/media",
              "host": ["{{gateway_url}}"],
              "path": ["api", "media"]
            },
            "description": "Ajouter un nouveau média (nécessite d'être authentifié, remplacer eventId par l'ID réel)"
          },
          "response": []
        },
        {
          "name": "Médias par événement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/media/event/1",
              "host": ["{{gateway_url}}"],
              "path": ["api", "media", "event", "1"]
            },
            "description": "Récupérer tous les médias d'un événement spécifique (remplacer 1 par l'ID réel)"
          },
          "response": []
        }
      ],
      "description": "Endpoints liés à la gestion des médias (images et vidéos)"
    },
    {
      "name": "5. Commentaires",
      "item": [
        {
          "name": "Ajouter un commentaire",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Quelle époque fascinante !\",\n  \"eventId\": 1\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/event/comments",
              "host": ["{{gateway_url}}"],
              "path": ["api", "event", "comments"]
            },
            "description": "Ajouter un nouveau commentaire (nécessite d'être authentifié, remplacer eventId par l'ID réel)"
          },
          "response": []
        },
        {
          "name": "Commentaires par événement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/event/events/1/comments",
              "host": ["{{gateway_url}}"],
              "path": ["api", "event", "events", "1", "comments"]
            },
            "description": "Récupérer tous les commentaires d'un événement spécifique (remplacer 1 par l'ID réel)"
          },
          "response": []
        }
      ],
      "description": "Endpoints liés à la gestion des commentaires sur les événements"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "URL de la gateway API"
    }
  ]
} 