					"// Script global exécuté avant chaque requête",
					"console.log('Executing request to:', pm.request.url.toString());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script global exécuté après chaque requête",
					"console.log('Response status:', pm.response.status);",
					"console.log('Response time:', pm.response.responseTime + 'ms');",
					"",
					"// Vérification automatique des codes de statut pour les listes vides",
					"if (pm.request.url.toString().includes('/api/') && pm.request.method === 'GET') {",
					"    if (pm.response.json() && Array.isArray(pm.response.json()) && pm.response.json().length === 0) {",
					"        pm.test('Empty list returns 200 OK', function () {",
					"            pm.response.to.have.status(200);",
					"        });",
					"        console.log('✅ Empty list handled correctly');",
					"    }",
					"}",
					"",
					"// Vérification automatique des erreurs 404",
					"if (pm.response.status === 'Not Found') {",
					"    pm.test('404 error has proper format', function () {",
					"        const jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('timestamp');",
					"        pm.expect(jsonData).to.have.property('message');",
					"        pm.expect(jsonData).to.have.property('status', 404);",
					"        pm.expect(jsonData).to.have.property('error');",
					"    });",
					"    console.log('✅ 404 error format is correct');",
					"}"
				]
			}
		}
