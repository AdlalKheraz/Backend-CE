					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.status === 'Created' || pm.response.status === 'OK') {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.globals.set('token', jsonData.token);",
									"        console.log('Token saved:', jsonData.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
