          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authorEmail\": \"user@example.com\",\n  \"content\": \"Fascinating event!\",\n  \"eventId\": 1\n}"
            },
            "url": {
