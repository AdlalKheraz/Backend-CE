{
  "info": {
    "name": "Chrono Event Service API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Civilizations",
      "item": [
        {
          "name": "Create Civilization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Egypt\",\n  \"description\": \"Ancient civilization in North Africa\",\n  \"startDate\": \"3000-01-01\",\n  \"endDate\": \"0030-01-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/civilizations",
              "host": ["{{base_url}}"],
              "path": ["api", "civilizations"]
            }
          }
        },
        {
          "name": "Get All Civilizations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/civilizations",
              "host": ["{{base_url}}"],
              "path": ["api", "civilizations"]
            }
          }
        },
        {
          "name": "Update Civilization",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ancient Egypt\",\n  \"description\": \"Updated description\",\n  \"startDate\": \"3100-01-01\",\n  \"endDate\": \"0030-01-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/civilizations/1",
              "host": ["{{base_url}}"],
              "path": ["api", "civilizations", "1"]
            }
          }
        },
        {
          "name": "Delete Civilization",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/civilizations/1",
              "host": ["{{base_url}}"],
              "path": ["api", "civilizations", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Building of Pyramids\",\n  \"description\": \"Construction of the Great Pyramids at Giza\",\n  \"date\": \"2550-01-01\",\n  \"civilizationId\": 1,\n  \"type\": \"CULTURAL\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/events",
              "host": ["{{base_url}}"],
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "Get All Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/events",
              "host": ["{{base_url}}"],
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "Get Events By Civilization",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/events/civilization/1",
              "host": ["{{base_url}}"],
              "path": ["api", "events", "civilization", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
